  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Send the CSRF token (saved by 'Get CSRF') on every request",
          "pm.request.headers.upsert({ key: 'X-CSRF-TOKEN', value: pm.collectionVariables.get('csrfToken') || '' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ]
}
